 ∧
  ∀ #l. (Lock( A, B, cs, cd, s, u, v ) @ #l) ⇒ ¬(#l < #m)"
*/
simplify
solve( !Pair( A, cs, B, cd ) ▶₀ #m )
  case Setup_Pair
  solve( !CommitHist( ~chainA, ~cs, s,

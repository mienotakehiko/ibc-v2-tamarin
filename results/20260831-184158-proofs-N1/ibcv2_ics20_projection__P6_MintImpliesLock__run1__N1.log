theory IBCv2_ICS20_Projection

begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup_Pair:
   [
   Fr( ~chainA ), Fr( ~chainB ), Fr( ~cs ), Fr( ~cd ), Fr( ~srcPort ),
   Fr( ~dstPort )
   ]
  --[ PairSetup( ~chainA, ~cs, ~chainB, ~cd ) ]->
   [
   !Pair( ~chainA, ~cs, ~chainB, ~cd ), !Port( ~chainA, ~srcPort ),
   !Port( ~chainB, ~dstPort ),
   Out( <~chainA, ~chainB, ~cs, ~cd, ~srcPort, ~dstPort> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICS20_UserFunds:
   [ !Pair( A, cs, B, cd ), Fr( ~u ), Fr( ~v ) ]
  --[ Funded( A, ~u, ~v ) ]->
   [ Funds( A, ~u, ~v ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICS20_SendPacket:
   [
   !Pair( A, cs, B, cd ), !Port( A, srcPort ), !Port( B, dstPort ),
   Funds( A, u, v ), Fr( ~s ), In( tau )
   ]
  --[
  Send( A, B, <cs, cd, ~s, tau, srcPort, dstPort, 'ICS20', u, v>, cs, cd,
        ~s, tau, srcPort, dstPort
  ),
  Lock( A, B, cs, cd, ~s, u, v )
  ]->
   [
   !CommitHist( A, cs, ~s,
                h(<cs, cd, ~s, tau, srcPort, dstPort, 'ICS20', u, v>)
   ),
   PacketOpen( A, B, cs, cd, ~s,
               <cs, cd, ~s, tau, srcPort, dstPort, 'ICS20', u, v>, u, v
   ),
   Escrow( A, B, cs, cd, ~s, u, v ),
   Out( <cs, cd, ~s, tau, srcPort, dstPort, 'ICS20', u, v> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICS20_RecvAndMint:
   [
   !Pair( A, cs, B, cd ), !CommitHist( A, cs, s, hh ),
   PacketOpen( A, B, cs, cd, s,
               <cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v>, u, v
   ),
   In( <cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v> )
   ]
  --[
  Eq( hh, h(<cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v>) ),
  Recv( B, A, <cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v>, cs, cd, s,
        tau, srcPort, dstPort
  ),
  Mint( B, A, cs, cd, s, u, v )
  ]->
   [ !Receipt( B, cd, s ), Voucher( B, A, cs, cd, s, u, v ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ICS20_TimeoutAndRefund:
   [
   !Pair( A, cs, B, cd ), !CommitHist( A, cs, s, hh ),
   PacketOpen( A, B, cs, cd, s,
               <cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v>, u, v
   ),
   Escrow( A, B, cs, cd, s, u, v ),
   In( <cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v> )
   ]
  --[
  Eq( hh, h(<cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v>) ),
  Timeout( A, B, <cs, cd, s, tau, srcPort, dstPort, 'ICS20', u, v>, cs, cd,
           s, tau
  ),
  Refund( A, B, cs, cd, s, u, v )
  ]->

  all-traces
  "∀ B A cs cd s u v #m.
    (Mint( B, A, cs, cd, s, u, v ) @ #m) ⇒
    (∃ #l. (Lock( A, B, cs, cd, s, u, v ) @ #l) ∧ (#l < #m))"

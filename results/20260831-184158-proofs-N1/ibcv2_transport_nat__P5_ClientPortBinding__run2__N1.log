rule (modulo E) Setup_Pair:
   [
   Fr( ~chainA ), Fr( ~chainB ), Fr( ~cs ), Fr( ~cd ), Fr( ~srcPort ),
   Fr( ~dstPort )
   ]
  --[
  PairSetup( ~chainA, ~cs, ~chainB, ~cd ), PortBound( ~chainA, ~srcPort ),
  PortBound( ~chainB, ~dstPort )
  ]->
   [
   !Pair( ~chainA, ~cs, ~chainB, ~cd ), !Port( ~chainA, ~srcPort ),
   !Port( ~chainB, ~dstPort ), NextSeq( ~chainA, ~cs, %1 ),
   Height( ~chainB, %1 ),
   Out( <~chainA, ~chainB, ~cs, ~cd, ~srcPort, ~dstPort> )
   ]

  /* has exactly the trivial AC variant */


  /* has exactly the trivial AC variant */

rule (modulo E) SendPacket:
   [
   !Pair( A, cs, B, cd ), !Port( A, srcPort ), !Port( B, dstPort ),
   NextSeq( A, cs, %s ), Fr( ~data ), In( %tau )
   ]
  --[
  Send( A, B, <cs, cd, %s, %tau, srcPort, dstPort, ~data>, cs, cd, %s,
        %tau, srcPort, dstPort
  ),
  SendUnique( A, cs, %s )
  ]->
   [
   !CommitHist( A, cs, %s, h(<cs, cd, %s, %tau, srcPort, dstPort, ~data>) ),
   CommitOpen( A, cs, %s, h(<cs, cd, %s, %tau, srcPort, dstPort, ~data>) ),
   RecvOpen( B, cd, %s ), NextSeq( A, cs, (%s%+%1) ),
   Out( <cs, cd, %s, %tau, srcPort, dstPort, ~data> )
   ]

  // loop breaker: [3]
  /* has exactly the trivial AC variant */

rule (modulo E) RecvPacket:
